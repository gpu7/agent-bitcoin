FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "grpcio>=1.60.0" "lnd-grpc-client>=0.5.0"
COPY origin.py generate_script_pdf.py mempool_feerate.py mempool_backlog.py fee_for_vsize.py confirm_target.py btc_usd.py ln_path_fee_hint.py /app/
ENV L402_ORIGIN_HOST=0.0.0.0
ENV L402_ORIGIN_PORT=8090
EXPOSE 8090
CMD ["python", "/app/origin.py"]
