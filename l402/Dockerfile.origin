FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "grpcio>=1.60.0" "lnd-grpc-client>=0.5.0" "bolt11>=2.2.0"
COPY origin.py generate_script_pdf.py mempool_feerate.py mempool_backlog.py fee_for_vsize.py confirm_target.py btc_usd.py ln_path_fee_hint.py ln_invoice_decode.py ln_invoice_preflight.py nostr_event_verify.py nostr_npub_decode.py btc_address_validate.py l402_challenge_inspect.py ln_channel_stats.py ln_node_info.py btc_fee_estimate.py btc_chain_status.py btc_network_info.py btc_mempool_info.py btc_peer_info.py btc_difficulty.py btc_block_tip.py btc_block_header.py btc_tx_summary.py btc_address_balance.py btc_uptime.py btc_deployment_info.py btc_mining_info.py btc_mempool_fees.py btc_chain_tips.py /app/
COPY well-known/l402-services.json /app/well-known/l402-services.json
COPY well-known/402index-verify.txt /app/well-known/402index-verify.txt
ENV L402_ORIGIN_HOST=0.0.0.0
ENV L402_ORIGIN_PORT=8090
EXPOSE 8090
CMD ["python", "/app/origin.py"]
