# Copy to .env and fill in real values. Never commit .env.

# Container names (for Docker-based regtest)
CONTAINER_PAYMENT_DECISION=agent-payment-decision-lnd
CONTAINER_BITCOIN=agent-bitcoin-lnd

# LND network for SDK / backend lncli (default: regtest)
# LND_NETWORK=regtest
# Signet (see docs/signet.md):
# LND_NETWORK=signet
# LND_CONTAINER=agent-payment-decision-lnd-signet

# Macaroon paths (on your host machine)
MACAROON_PAYMENT_DECISION=/tmp/agent-payment-decision.macaroon
MACAROON_BITCOIN=/tmp/agent-bitcoin.macaroon

# Optional: Lightning node host if not using Docker
# LND_HOST=localhost
# LND_PORT=10009
# LND_DIR=/home/lnd/.lnd

# --- Backend API security (required for /balance, /invoices, /pay, /send-fee) ---
# Generate: openssl rand -hex 32
AGENT_BITCOIN_API_KEY=

# Backend fee collection (on-chain)
# FEE_SATS=21
# FEE_ADDRESS=

# Shared payment bounds (sats) — see agent_bitcoin/constants.py
# MIN_PAYMENT_SATS=1000
# MAX_PAYMENT_SATS=1000000

# --- NWC automatic wallets (NIP-47); default OFF ---
# AGENT_BITCOIN_NWC_ENABLE=0
# Mainnet NWC (N6) also requires all of:
#   LND_NETWORK=mainnet
#   AGENT_BITCOIN_ALLOW_MAINNET=1
#   AGENT_BITCOIN_NWC_ALLOW_MAINNET=1
# Tight mainnet budget (defaults to 2000 if unset on mainnet):
# NWC_MAX_PAYMENT_SATS=2000
# NWC_MIN_PAYMENT_SATS=1000
# NWC_FEE_LIMIT_SATS=50

# Optional aliases (same default as MAX_PAYMENT_SATS if unset):
# MAX_INVOICE_SATS=1000000
# PAYMENT_DECISION_MAX_SATS=1000000
# MAX_FEE_SEND_SATS=100000
# FEE_AMOUNT_SATS=21
# FEE_SATS=21
# PAYMENT_DECISION_CONFIRM_ABOVE_SATS=500000

# Channel liquidity floors for check-aws-health.sh (sats)
# CHANNEL_MIN_LOCAL_SATS=5000
# CHANNEL_MIN_REMOTE_SATS=5000
# CHANNEL_LIQUIDITY_STRICT=0
# CHANNEL_MIN_ACTIVE=1
